# Copia este archivo a .env y llena los valores reales. Nunca subas .env a git.

PORT=8787
NODE_ENV=development
# Dominio real donde vive el frontend en producción. Separa varios con
# comas si hace falta. En producción, CORS solo acepta lo que esté aquí.
FRONTEND_ORIGIN=https://tu-dominio.com

# --- Base de datos (Postgres) ---
# Usa cualquiera de estos, todos tienen plan gratuito suficiente para
# empezar: Supabase (supabase.com), Neon (neon.tech), o Railway
# (railway.app). Cada uno te da un connection string listo para pegar
# aquí — normalmente aparece como "Connection string" o "Database URL"
# en su panel, formato: postgresql://usuario:contraseña@host:puerto/basededatos
DATABASE_URL=postgresql://usuario:contraseña@host:5432/basededatos

# --- Stripe (https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=sk_test_reemplaza_esto
STRIPE_WEBHOOK_SECRET=whsec_reemplaza_esto

# --- Cupo al seminario de fin de semana (un solo producto, sin separar
# Forex/Opciones) — preventa $70 y precio normal $100. Crea DOS precios
# en Stripe (mismo producto o productos distintos, como prefieras).
STRIPE_PRICE_WEEKEND_PRESALE=price_reemplaza_preventa
STRIPE_PRICE_WEEKEND_REGULAR=price_reemplaza_normal
# Cuánto mostrar en pantalla junto a cada precio (solo texto, no afecta el cobro real)
WEEKEND_PRESALE_DISPLAY_AMOUNT=$70
WEEKEND_REGULAR_DISPLAY_AMOUNT=$100
# Fecha límite de la preventa, en formato UNIX (segundos). Antes de esta
# fecha se cobra el precio de preventa; después, el normal. Cambia este
# número cuando quieras sin tocar código. Puedes generarlo aquí:
# https://www.epochconverter.com/ (elige la fecha/hora y copia el número).
PRESALE_ENDS_AT_UNIX=

# URLs a las que Stripe redirige tras el pago
CHECKOUT_SUCCESS_URL=https://lucky-torrone-138093.netlify.app/src/dashboard/bienvenida.html?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=https://lucky-torrone-138093.netlify.app/index.html

# --- Sesión (para firmar los JWT que recibe el dashboard) ---
SESSION_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria

# --- Control de dispositivos ---
# Cuántos dispositivos puede tener activos una cuenta antes de avisarle
# al alumno (nunca lo cerramos automáticamente, ver src/routes/account.js).
MAX_DEVICES_PER_ACCOUNT=2

# --- Video: Cloudflare Stream (Signed URLs) ---
# https://developers.cloudflare.com/stream/viewing-videos/securing-your-stream/
# 1. Sube cada video a Cloudflare Stream y activa "Require signed URLs".
# 2. En el panel de Stream > Settings > Signing Keys, crea una clave y
#    copia aquí el Key ID y la clave privada (PEM).
# 3. Copia tu "Customer Code" (aparece en la URL de reproducción de
#    cualquier video, la parte que dice "customer-XXXXX").
CF_STREAM_KEY_ID=reemplaza_con_tu_key_id
CF_STREAM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreemplaza\n-----END PRIVATE KEY-----"
CF_STREAM_CUSTOMER_CODE=reemplaza_con_tu_customer_code
# Mapa de módulo -> uid del video en Cloudflare Stream, en JSON de una
# sola línea. Actualízalo cada vez que subas un módulo nuevo.
CF_STREAM_MODULE_MAP={"modulo-1":"33a52eac539f0fa15e5376114644eb9f","modulo-2":"f111b82960930db3db5a69090a538724","modulo-3":"38b64fa6dd85255a8b471940bdcd1173","modulo-4":"a6ee243c583776f212511ad808510c43"}
# Qué módulos incluye cada curso. Si un módulo falta aquí, se bloquea por
# defecto — nunca se concede acceso "por si acaso".
COURSE_MODULE_MAP={"weekend":["modulo-1","modulo-2","modulo-3","modulo-4","modulo-5","modulo-6","modulo-7"],"forex":["modulo-1","modulo-2","modulo-3","modulo-4","modulo-6","modulo-7"],"opciones":["modulo-1","modulo-2","modulo-3","modulo-5","modulo-6","modulo-7"]}
# Se limita a 60-3600 segundos en código, sin importar lo que pongas aquí. Recomendado: 900 (15 min).
VIDEO_LINK_TTL_SECONDS=900

# --- Notificaciones (opcional) ---
# Ej: Twilio WhatsApp API para enviar el código de acceso automáticamente
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ============================================================
# ZONA ELITE ($700-1000) — segunda comprobación, plantillas,
# en vivo por Zoom y grabaciones. No afecta nada del curso base.
# ============================================================

# DOS productos de Stripe para la oferta Elite (créalos aparte del cupo
# del fin de semana):
#   - ELITE_BASE ($500): el alumno ya tiene la plantilla, solo compra la
#     ruta completa (en vivo entre semana + grabaciones).
#   - ELITE_FULL ($1,099): incluye la plantilla + todo lo demás. Es la
#     opción que el frontend muestra destacada/dorada.
STRIPE_PRICE_ELITE_BASE=price_reemplaza_elite_base
STRIPE_PRICE_ELITE_FULL=price_reemplaza_elite_full
# Dashboard de Stripe > Developers > Webhooks > Add endpoint, apuntando a
# https://tu-backend-en-render.onrender.com/api/webhook-elite
# Copia el "Signing secret" de ESE endpoint (es distinto al del webhook base)
STRIPE_WEBHOOK_SECRET_ELITE=whsec_reemplaza_elite

# Fecha (UNIX, segundos) en que se DESBLOQUEA la oferta Elite dentro del
# dashboard — normalmente el domingo en la noche, al terminar el curso.
# Mientras no llegue esta fecha, los dos cuadros de precio ($500/$1,099)
# quedan ocultos aunque el alumno ya esté dentro del curso. Vacío = nunca
# se muestra (por seguridad, hasta que la pongas).
ELITE_OFFER_UNLOCKS_AT_UNIX=

# Opcional: si quieres una página de éxito distinta a la del curso base
# tras pagar Elite. Si las dejas vacías, usa las mismas de arriba.
CHECKOUT_ELITE_SUCCESS_URL=https://lucky-torrone-138093.netlify.app/src/dashboard/bienvenida.html?session_id={CHECKOUT_SESSION_ID}&type=elite
CHECKOUT_ELITE_CANCEL_URL=https://lucky-torrone-138093.netlify.app/src/dashboard/views/clases.html

# Igual que CF_STREAM_MODULE_MAP, pero solo para los videos de instalación
# de las plantillas Elite. Ya tienes 3 videos de Forex subidos — pon aquí
# sus UID reales (los mismos que ya usaste en modulo-1/2/3 del curso base
# si son los mismos videos, o unos nuevos si son distintos).
CF_STREAM_ELITE_MODULE_MAP={"modulo-1":"reemplaza_uid","modulo-2":"reemplaza_uid","modulo-3":"reemplaza_uid"}

# Salón de Zoom fijo (se reutiliza cada día, no hay que crear uno nuevo
# cada vez). Deja vacío si todavía no lo tienes — la pantalla dirá
# "Próximamente" en vez de mostrar un link roto.
ZOOM_LINK_FOREX=
ZOOM_LINK_OPCIONES=
# Textos que se muestran en pantalla junto al link (puedes ajustarlos)
ELITE_SCHEDULE_FOREX=Lunes a Viernes, 8:00 PM
ELITE_SCHEDULE_OPCIONES=Lunes a Viernes, 9:30 AM - 12:00 PM

# Clave para el panel de administración (/api/admin/...) — solo la usas
# tú, nunca un alumno. Invéntate cualquier cadena larga y aleatoria.
ADMIN_SECRET=cambia_esto_por_una_clave_larga_solo_para_ti

# ============================================================
# EN VIVO DEL CURSO BASE (los 2 días, sábado y domingo) — la única
# forma de acceso que tienen los alumnos de $70-100 esos dos días.
# ============================================================
ZOOM_LINK_ESCUELA_DIA1=
ZOOM_LINK_ESCUELA_DIA2=
ESCUELA_SCHEDULE_DIA1=Sábado, hora por confirmar
ESCUELA_SCHEDULE_DIA2=Domingo, hora por confirmar
